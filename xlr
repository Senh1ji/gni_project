---
apiVersion: xl-release/v1
kind: Templates
metadata:
  home: SMP/GNI
spec:
- template: GNI_DATA_MONETIQUE_APP
  scheduledStartDate: 2020-02-05T10:00:00+01:00
  phases:
  - phase: Build
    tasks:
    - name: "[XLD] Build NPS JAR"
      type: xlrelease.SequentialGroup
      precondition: "${XLD_build_jar}"
      tasks:
      - name: "[Jenkins] - Build Jar"
        type: jenkins.Build
        jenkinsServer: jenkins-din
        jobName: "${IUA}/job/${IUA}-Monetique-Jar"
        jobParameters: "JAR_VERSION=${Jenkins_jar_TAG}"
      - name: "[XLD] - get version Jar"
        type: xldeploy.GetLatestVersionTask
        xldeployServer: XLDeploy_SMP
        applicationId: "Applications/SMP_${IUA}/${IUA}_JAR"
        variableMapping:
          pythonScript.packageId: "${XLD_jar_version}"
      - name: "[XLD] - variable Data"
        type: xlrelease.ScriptTask
        script: |-
          XLDVERSION=releaseVariables["XLD_jar_version"]
          package=XLDVERSION.replace('Applications/','')
          releaseVariables["XLD_jar_version"]=package
    - name: "[XLD] Build Data"
      type: xlrelease.SequentialGroup
      tasks:
      - name: "[Jenkins] - Build data"
        type: jenkins.Build
        jenkinsServer: jenkins-din
        jobName: "${IUA}/job/${IUA}-Monetique-Data"
        jobParameters: "BUILD_TAG=${Jenkins_data_TAG}"
      - name: "[XLD] - get version Data"
        type: xldeploy.GetLatestVersionTask
        xldeployServer: XLDeploy_SMP
        applicationId: "Applications/SMP_${IUA}/${IUA}_DATA"
        variableMapping:
          pythonScript.packageId: "${XLD_terraform_version}"
      - name: "[XLD] - variable Data"
        type: xlrelease.ScriptTask
        script: |-
          XLDVERSION=releaseVariables["XLD_terraform_version"]
          package=XLDVERSION.replace('Applications/','')
          releaseVariables["XLD_terraform_version"]=package
    color: '#009CDB'
  - phase: UAT
    tasks:
    - name: Variables
      type: xlrelease.ScriptTask
      script: |-
        releaseVariables['ENV']="UAT"
        releaseVariables['XLDENV_FOLDER']="20_UAT"
        releaseVariables['XLDENV_LETTER']="U"


        from datetime import datetime, timedelta

        releaseVariables["SNOW_DATE_BEGIN"] =(datetime.now() + timedelta(minutes=2)).strftime("%d-%m-%Y %H:%M:%S")
        releaseVariables["SNOW_DATE_END"] = (datetime.now() + timedelta(days=7) + timedelta(hours=4)).strftime("%d-%m-%Y %H:%M:%S")

        user = userApi.getUser('${release.owner}')
        releaseVariables['OWNER_EMAIL'] = user.email
    - name: "[XLD] ${ENV} - deploy Jar - ${XLD_jar_version}"
      type: xldeploy.Deploy
      server: XLDeploy_SMP
      deploymentPackage: "${XLD_jar_version}"
      deploymentEnvironment: "${XLDENV_FOLDER}/SMP_GNI/GNI_TERRAFORM/${XLDENV_LETTER}GNI_TERRAFORM"
      numberOfContinueRetrials: 0
      pollingInterval: 10
      numberOfPollingTrials: 0
      displayStepLogs: true
      connectionRetries: 10
      rollbackOnFailure: false
      precondition: "${XLD_build_jar}"
    - name: "[XLD] ${ENV} - deploy Data - ${XLD_terraform_version}"
      type: xldeploy.Deploy
      server: XLDeploy_SMP
      deploymentPackage: "${XLD_terraform_version}"
      deploymentEnvironment: "${XLDENV_FOLDER}/SMP_GNI/GNI_TERRAFORM/${XLDENV_LETTER}GNI_TERRAFORM"
      numberOfContinueRetrials: 0
      pollingInterval: 10
      numberOfPollingTrials: 0
      displayStepLogs: true
      connectionRetries: 10
      rollbackOnFailure: false
    - name: "${ENV} - Validate"
      type: xlrelease.GateTask
      team: Dev
      conditions:
      - name: "${ENV} is validated"
        type: xlrelease.GateCondition
    color: '#009CDB'
  - phase: BCH
    tasks:
    - name: Variables
      type: xlrelease.ScriptTask
      locked: true
      script: |-
        releaseVariables['ENV']="BCH"
        releaseVariables['XLDENV_FOLDER']="30_BENCH"
        releaseVariables['XLDENV_LETTER']="B"
        releaseVariables['retry_attempt']=0


        from datetime import datetime, timedelta

        releaseVariables["SNOW_DATE_BEGIN"] =(datetime.now() + timedelta(minutes=2)).strftime("%d-%m-%Y %H:%M:%S")
        releaseVariables["SNOW_DATE_END"] = (datetime.now() + timedelta(days=7) + timedelta(hours=4)).strftime("%d-%m-%Y %H:%M:%S")

        user = userApi.getUser('${release.owner}')
        releaseVariables['OWNER_EMAIL'] = user.email
    - name: "[SUN] - ${ENV} Create Change"
      type: servicenowNxs.CreateChangeRequest
      servicenowNxsServer: Server SUN
      iua: "NX${IUA}"
      requestedBy: "${OWNER_EMAIL}"
      assignmentgroup: PRD-APP-PEP-DFS
      environment: Bench
      snowType: Standard
      modelNumber: STPL0001057
      ^startDate: "${SNOW_DATE_BEGIN}"
      ^endDate: "${SNOW_DATE_END}"
      shortDescription: "${IUA} - release - ${release.title}"
      createInDraftState: true
      ^description: |-
        Release ${ENV} - ${release.title}

        JRA:

        XLD env :
        ${XLDENV_FOLDER}/SMP_GOG/GOG_TERRAFORM/${XLDENV_LETTER}GOG_TERRAFORM

        Application:
        ${XLD_terraform_version}

        Info XLR
        Release URL ${release.url}
      rollbackPlan: Previous Version
      assessmentTask: false
      variableMapping:
        pythonScript.changeRequestUrl: "${SUN_BCH_URL}"
        pythonScript.changeRequestNumber: "${snownumber}"
      locked: true
    - name: "[SUN] ${ENV} ${snownumber} Update Change to Schedule"
      type: servicenowNxs.UpdateChangeState
      servicenowNxsServer: Server SUN
      changeNumber: "${snownumber}"
      newState: Scheduled
      comment: XLRelease Updated to Scheduled
      locked: true
    - name: "[SUN] - ${ENV} ${snownumber} Update Change to Implement"
      type: servicenowNxs.UpdateChangeState
      servicenowNxsServer: Server SUN
      changeNumber: "${snownumber}"
      newState: Implement
      comment: XLRelease Updated to Scheduled
      locked: true
    - name: "[SUN] ${ENV} ${snownumber} Wait for Implement Status"
      type: servicenowNxs.WaitChgReqForPhase
      servicenowNxsServer: Server SUN
      changeRequestNumber: "${snownumber}"
      waitForPhase: Implement
      taskVarPrefix: bench
      locked: true
    - name: "[SUN] Start Task"
      type: servicenowNxs.UpdateTask
      servicenowNxsServer: Server SUN
      taskNumber: "${bench_snow_task_0}"
      updateAs: "${SNOW_EMAIL_CLOSE}"
      closeNotes: XLRelease Updated task to In progress
      locked: true
    - name: "[XLD] ${ENV} - deploy Jar - ${XLD_jar_version}"
      type: xldeploy.Deploy
      server: XLDeploy_SMP
      deploymentPackage: "${XLD_jar_version}"
      deploymentEnvironment: "${XLDENV_FOLDER}/SMP_GNI/GNI_TERRAFORM/${XLDENV_LETTER}GNI_TERRAFORM"
      numberOfContinueRetrials: 0
      pollingInterval: 10
      numberOfPollingTrials: 0
      displayStepLogs: true
      connectionRetries: 10
      rollbackOnFailure: false
      precondition: "${XLD_build_jar}"
    - name: "[XLD] ${ENV} - deploy Data - ${XLD_terraform_version}"
      type: xldeploy.Deploy
      server: XLDeploy_SMP
      deploymentPackage: "${XLD_terraform_version}"
      deploymentEnvironment: "${XLDENV_FOLDER}/SMP_GNI/GNI_TERRAFORM/${XLDENV_LETTER}GNI_TERRAFORM"
      numberOfContinueRetrials: 0
      pollingInterval: 10
      numberOfPollingTrials: 0
      displayStepLogs: true
      connectionRetries: 10
      rollbackOnFailure: false
    - name: "[SUN] ${ENV} ${snownumber} - Close task"
      type: servicenowNxs.UpdateTask
      servicenowNxsServer: Server SUN
      taskNumber: "${bench_snow_task_0}"
      updateAs: "${global.SNOW-DFS_UserTaskCloser}"
      ^status: Close complete
      closeNotes: Done
      locked: true
    - name: "[SUN] Close Change"
      type: servicenowNxs.UpdateChangeState
      servicenowNxsServer: Server SUN
      changeNumber: "${snownumber}"
      newState: Closed
      comment: XLRelease Closed the Change
      closeNotes: Closed by XLR
      failureHandler: |-
        import time

        if (releaseVariables['retry_attempt'] < 5):
          releaseVariables['retry_attempt'] = releaseVariables['retry_attempt'] + 1
          time.sleep(30)
          taskApi.retryTask(getCurrentTask().getId(), "Retrying task from failure handler.")
        else:
          taskApi.abortTask(getCurrentTask().getId(), "Abort task from failure handler.")
      taskFailureHandlerEnabled: true
      taskRecoverOp: RUN_SCRIPT
      locked: true
    - name: "${ENV} - Validate"
      type: xlrelease.GateTask
      team: Dev
      conditions:
      - name: "${ENV} is validated"
        type: xlrelease.GateCondition
    color: '#009CDB'
  - phase: PRD
    tasks:
    - name: Variables
      type: xlrelease.ScriptTask
      locked: true
      script: |-
        releaseVariables['ENV']="PRD"
        releaseVariables['XLDENV_FOLDER']="40_PRD"
        releaseVariables['XLDENV_LETTER']="P"


        from datetime import datetime, timedelta

        releaseVariables["SNOW_DATE_BEGIN"] = (datetime.now() + timedelta(minutes=2)).strftime("%d-%m-%Y %H:%M:%S")
        releaseVariables["SNOW_DATE_END"] = (datetime.now() + timedelta(hours=4)).strftime("%d-%m-%Y %H:%M:%S")

        user = userApi.getUser('${release.owner}')
        releaseVariables['OWNER_EMAIL'] = user.email
    - name: DATE_LBM
      type: xlrelease.UserInputTask
      description: Please enter the required information below.
      team: Dev
      variables:
      - SNOW_DATE_BEGIN
      - SNOW_DATE_END
    - name: "[SUN] - ${ENV} Create Change"
      type: servicenowNxs.CreateChangeRequest
      servicenowNxsServer: Server SUN
      iua: "NX${IUA}"
      requestedBy: "${OWNER_EMAIL}"
      assignmentgroup: PRD-APP-PEP-DFS
      environment: Production
      ^startDate: "${SNOW_DATE_BEGIN}"
      ^endDate: "${SNOW_DATE_END}"
      shortDescription: "${IUA} - release - ${release.title}"
      ^description: |-
        Release ${ENV} - ${release.title}

        JRA:

        XLD env :
        ${XLDENV_FOLDER}/SMP_${IUA}/${IUA}_TERRAFORM/${XLDENV_LETTER}${IUA}_TERRAFORM

        Application:
        ${XLD_terraform_version}
        ${XLD_jar_version}

        Info XLR
        Release URL ${release.url}
      rollbackPlan: Deploy last version
      releaseVersion: "${LBM_RELEASE}"
      assessmentTask: false
      nonProdChange: "${snownumber}"
      variableMapping:
        pythonScript.changeRequestNumber: "${SNOW_PROD_NUMBER}"
        pythonScript.changeRequestUrl: "${SNOW_PROD_URL}"
      locked: true
    - name: "[SUN] Update Change State to Implement"
      type: servicenowNxs.UpdateChangeState
      servicenowNxsServer: Server SUN
      changeNumber: "${SNOW_PROD_NUMBER}"
      newState: Implement
      comment: XLRelease Updated to Implement
      precondition: "False"
      locked: true
    - name: "[SUN] Waiting Implement Status"
      type: servicenowNxs.WaitChgReqForPhase
      servicenowNxsServer: Server SUN
      changeRequestNumber: "${SNOW_PROD_NUMBER}"
      waitForPhase: Implement
      taskVarPrefix: prod
      locked: true
    - name: "[SUN] Start Change"
      type: servicenowNxs.UpdateTask
      servicenowNxsServer: Server SUN
      taskNumber: "${prod_sun_task_10}"
      updateAs: "${SNOW_EMAIL_CLOSE}"
      closeNotes: XLRelease Updated task to In progress
      locked: true
    - name: "${ENV} - Go from ProdAppli"
      type: xlrelease.GateTask
      team: Release Admin
      locked: true
      conditions:
      - name: Go ProdAppli
        type: xlrelease.GateCondition
    - name: "[XLD] ${ENV} - deploy Jar - ${XLD_jar_version}"
      type: xldeploy.Deploy
      server: XLDeploy_SMP
      deploymentPackage: "${XLD_jar_version}"
      deploymentEnvironment: "${XLDENV_FOLDER}/SMP_GNI/GNI_TERRAFORM/${XLDENV_LETTER}GNI_TERRAFORM"
      numberOfContinueRetrials: 0
      pollingInterval: 10
      numberOfPollingTrials: 0
      displayStepLogs: true
      connectionRetries: 10
      rollbackOnFailure: false
      precondition: "${XLD_build_jar}"
    - name: "[XLD] ${ENV} - deploy Data- ${XLD_terraform_version}"
      type: xldeploy.Deploy
      server: XLDeploy_SMP
      deploymentPackage: "${XLD_terraform_version}"
      deploymentEnvironment: "${XLDENV_FOLDER}/SMP_GNI/GNI_TERRAFORM/${XLDENV_LETTER}GNI_TERRAFORM"
      numberOfContinueRetrials: 0
      pollingInterval: 10
      numberOfPollingTrials: 0
      displayStepLogs: true
      connectionRetries: 10
      rollbackOnFailure: false
    - name: "[SUN] ${ENV} - Close task"
      type: servicenowNxs.UpdateTask
      servicenowNxsServer: Server SUN
      taskNumber: "${prod_sun_task_10}"
      updateAs: "${global.SNOW-DFS_UserTaskCloser}"
      ^status: Close complete
      closeNotes: XLRelease Updated task to close complete
      locked: true
    - name: "[SUN] - Close Change"
      type: servicenowNxs.UpdateChangeState
      servicenowNxsServer: Server SUN
      changeNumber: "${SNOW_PROD_NUMBER}"
      newState: Closed
      comment: XLRelease Closed the Change
      locked: true
    color: '#009CDB'
  tags:
  - GNI
  variables:
  - type: xlrelease.StringVariable
    key: XLD_terraform_version
    requiresValue: false
    showOnReleaseStart: false
  - type: xlrelease.StringVariable
    key: ENV
    requiresValue: false
    showOnReleaseStart: false
  - type: xlrelease.StringVariable
    key: XLDENV_FOLDER
    requiresValue: false
    showOnReleaseStart: false
  - type: xlrelease.StringVariable
    key: XLDENV_LETTER
    requiresValue: false
    showOnReleaseStart: false
  - type: xlrelease.StringVariable
    key: OWNER_EMAIL
    requiresValue: false
    showOnReleaseStart: false
  - type: xlrelease.StringVariable
    key: SNOW_DATE_BEGIN
    showOnReleaseStart: false
    description: "date format : dd-mm-yyyy hh:mm:ss (ex 25-01-2022 15:00:00)"
  - type: xlrelease.StringVariable
    key: SNOW_DATE_END
    showOnReleaseStart: false
    description: "date format : dd-mm-yyyy hh:mm:ss (ex 25-01-2022 18:00:00)"
  - type: xlrelease.StringVariable
    key: snownumber
    requiresValue: false
    showOnReleaseStart: false
  - type: xlrelease.MapStringStringVariable
    key: SNW_TASK_KEY
    requiresValue: false
    showOnReleaseStart: false
  - type: xlrelease.StringVariable
    key: XLD_transfert_version
    requiresValue: false
    showOnReleaseStart: false
  - type: xlrelease.BooleanVariable
    key: XLD_build_jar
    label: build and deploy datafactory-nps jar
  - type: xlrelease.StringVariable
    key: Jenkins_jar_TAG
    requiresValue: false
    label: Version for the datafactory-nps jar
  - type: xlrelease.StringVariable
    key: Jenkins_data_TAG
    label: Git tag for the package data
  - type: xlrelease.StringVariable
    key: XLD_jar_version
    requiresValue: false
    showOnReleaseStart: false
  - type: xlrelease.StringVariable
    key: SNOW_PROD_NUMBER
    requiresValue: false
    showOnReleaseStart: false
  - type: xlrelease.StringVariable
    key: SNOW_PROD_URL
    requiresValue: false
    showOnReleaseStart: false
  - type: xlrelease.ListStringVariable
    key: SNW_TASK
    requiresValue: false
    showOnReleaseStart: false
  - type: xlrelease.DateVariable
    key: Date_MEP
    requiresValue: false
    showOnReleaseStart: false
    label: Date MEP
    description: Date of MEP start. Should be on LBM Mondays at 10:00 or 15:00
  - type: xlrelease.StringVariable
    key: IUA
    requiresValue: false
    showOnReleaseStart: false
    value: GNI
  - type: xlrelease.StringVariable
    key: SUN_BCH_URL
    requiresValue: false
    showOnReleaseStart: false
  - type: xlrelease.StringVariable
    key: prod_sun_task_10
    requiresValue: false
    showOnReleaseStart: false
  - type: xlrelease.StringVariable
    key: LBM_RELEASE
    description: Define the LBM Date from the ComboBox
    valueProvider:
      type: xlrelease.ListOfStringValueProviderConfiguration
      variableMapping:
        values: "${global.SUN_DFS_LBM}"
  - type: xlrelease.StringVariable
    key: bench_snow_task_0
    requiresValue: false
    showOnReleaseStart: false
  - type: xlrelease.StringVariable
    key: SNOW_EMAIL_CLOSE
    requiresValue: false
    showOnReleaseStart: false
    value: "${global.SNOW-DFS_UserTaskCloser}"
  scriptUsername: adgnhproc
  scriptUserPassword: !value "xlrelease_Release_GNI_DATA_MONETIQUE_APP_scriptUserPassword"
  riskProfile: Default risk profile
